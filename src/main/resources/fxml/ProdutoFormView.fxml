<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    Cadastro de produto (tema v2): novo ou edição. Erros aparecem no próprio campo.
    Camada de View desacoplada da lógica; toda interação vai para o ProdutoFormController.
-->
<StackPane fx:id="rootStack" styleClass="v2-root" prefHeight="800.0" prefWidth="1366.0" minHeight="700.0" minWidth="1100.0"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.farmacia.controller.ProdutoFormController">
    <stylesheets>
        <URL value="@../css/tema-v2.css"/>
        <URL value="@../css/tema-v2-produto.css"/>
    </stylesheets>

    <BorderPane fx:id="rootPane">
        <left>
            <fx:include fx:id="menuLateral" source="componentes/MenuLateral.fxml"/>
        </left>

        <center>
            <VBox>
                <VBox spacing="4.0">
                    <padding>
                        <Insets top="28.0" right="40.0" bottom="16.0" left="40.0"/>
                    </padding>
                    <HBox spacing="6.0" alignment="CENTER_LEFT" styleClass="v2-trilha">
                        <Label text="Início" styleClass="v2-trilha"/>
                        <Label text="/" styleClass="v2-trilha"/>
                        <Label fx:id="lnkLista" text="Produtos" styleClass="v2-trilha-link"/>
                        <Label text="/" styleClass="v2-trilha"/>
                        <Label fx:id="lblTrilhaAtual" text="Novo produto" styleClass="v2-trilha"/>
                    </HBox>
                    <Label fx:id="lblTituloPagina" text="Novo produto" styleClass="v2-titulo"/>
                    <Label fx:id="lblSubtituloPagina" styleClass="v2-subtitulo"/>
                </VBox>

                <ScrollPane fitToWidth="true" styleClass="v2-scroll" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox spacing="20.0">
                            <padding>
                                <Insets top="4.0" right="40.0" bottom="24.0" left="40.0"/>
                            </padding>
                            <HBox spacing="6.0" alignment="CENTER_LEFT">
                                <Label text="*" styleClass="v2-obrigatorio"/>
                                <Label text="Campo obrigatório" styleClass="v2-secao-dica"/>
                            </HBox>
                            <VBox styleClass="v2-form-cartao" spacing="16.0">
                                <Label text="Dados do produto" styleClass="v2-secao-titulo"/>
                                <GridPane hgap="16.0" vgap="16.0">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="25.0"/>
                                        <ColumnConstraints percentWidth="25.0"/>
                                        <ColumnConstraints percentWidth="25.0"/>
                                        <ColumnConstraints percentWidth="25.0"/>
                                    </columnConstraints>
                                    <VBox styleClass="v2-campo" spacing="6.0" GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.columnSpan="1">
                                        <HBox spacing="4.0" alignment="CENTER_LEFT">
                                            <Label text="Código" styleClass="v2-label"/>
                                        </HBox>
                                        <TextField fx:id="txtCodigo" promptText="Automático" styleClass="v2-input, v2-input-leitura" editable="false"/>
                                    </VBox>
                                    <VBox styleClass="v2-campo" spacing="6.0" GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.columnSpan="3">
                                        <HBox spacing="4.0" alignment="CENTER_LEFT">
                                            <Label text="Nome" styleClass="v2-label"/>
                                            <Label text="*" styleClass="v2-obrigatorio"/>
                                        </HBox>
                                        <TextField fx:id="txtNome" promptText="Nome do produto" styleClass="v2-input"/>
                                    </VBox>
                                    <VBox styleClass="v2-campo" spacing="6.0" GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.columnSpan="2">
                                        <HBox spacing="4.0" alignment="CENTER_LEFT">
                                            <Label text="Categoria" styleClass="v2-label"/>
                                        </HBox>
                                        <ComboBox fx:id="cbCategoria" editable="true" maxWidth="Infinity" promptText="Selecione ou digite" styleClass="v2-input"/>
                                    </VBox>
                                    <VBox styleClass="v2-campo" spacing="6.0" GridPane.rowIndex="1" GridPane.columnIndex="2" GridPane.columnSpan="1">
                                        <HBox spacing="4.0" alignment="CENTER_LEFT">
                                            <Label text="Preço (R$)" styleClass="v2-label"/>
                                        </HBox>
                                        <TextField fx:id="txtPreco" promptText="0,00" styleClass="v2-input"/>
                                    </VBox>
                                    <VBox styleClass="v2-campo" spacing="6.0" GridPane.rowIndex="1" GridPane.columnIndex="3" GridPane.columnSpan="1">
                                        <HBox spacing="4.0" alignment="CENTER_LEFT">
                                            <Label text="Quantidade em estoque" styleClass="v2-label"/>
                                        </HBox>
                                        <StackPane>
                                            <TextField fx:id="txtEstoque" promptText="0" styleClass="v2-input"/>
                                            <Label fx:id="lblSeloEstoque" styleClass="v2-selo-pequeno" visible="false" mouseTransparent="true" StackPane.alignment="CENTER_RIGHT">
                                                <StackPane.margin>
                                                    <Insets right="12.0"/>
                                                </StackPane.margin>
                                            </Label>
                                        </StackPane>
                                    </VBox>
                                </GridPane>
                            </VBox>
                        </VBox>
                    </content>
                </ScrollPane>

                <HBox styleClass="v2-barra-acoes">
                    <Button fx:id="btnCancelar" onAction="#handleCancelar" styleClass="v2-btn, v2-btn-ghost"/>
                    <Button fx:id="btnSalvarProduto" onAction="#handleSalvarProduto" styleClass="v2-btn, v2-btn-primary"/>
                </HBox>
            </VBox>
        </center>
    </BorderPane>
</StackPane>
