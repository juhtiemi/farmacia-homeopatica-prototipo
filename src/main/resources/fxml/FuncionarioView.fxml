<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    Lista de Funcionários (tema v2): busca, filtro por cargo e ações por linha.
    Camada de View desacoplada da lógica; toda interação vai para o FuncionarioController.
-->
<StackPane fx:id="rootStack" styleClass="v2-root" prefHeight="800.0" prefWidth="1366.0" minHeight="700.0" minWidth="1100.0"
           stylesheets="@../css/tema-v2.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.farmacia.controller.FuncionarioController">

    <BorderPane fx:id="rootPane">
        <left>
            <fx:include fx:id="menuLateral" source="componentes/MenuLateral.fxml"/>
        </left>

        <center>
            <VBox spacing="20.0">
                <padding>
                    <Insets top="28.0" right="40.0" bottom="32.0" left="40.0"/>
                </padding>

                <HBox alignment="BOTTOM_LEFT" spacing="16.0">
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <HBox spacing="6.0" alignment="CENTER_LEFT" styleClass="v2-trilha">
                            <Label text="Início" styleClass="v2-trilha"/>
                            <Label text="/" styleClass="v2-trilha"/>
                            <Label text="Funcionários" styleClass="v2-trilha"/>
                        </HBox>
                        <Label text="Funcionários" styleClass="v2-titulo"/>
                        <Label text="Cadastre e consulte os funcionários da farmácia e seus logins de acesso." styleClass="v2-subtitulo"/>
                    </VBox>
                    <Button fx:id="btnAjuda" onAction="#handleAjuda" styleClass="v2-btn, v2-btn-ghost"/>
                </HBox>

                <HBox fx:id="dicaBox" alignment="CENTER_LEFT" spacing="12.0" styleClass="v2-dica">
                    <StackPane fx:id="dicaIcone"/>
                    <Label wrapText="true" HBox.hgrow="ALWAYS"
                           text="O login identifica cada funcionário e não pode se repetir. Sem CPF ou telefone, o cadastro fica marcado como incompleto."/>
                    <Button text="Entendi" onAction="#handleDispensarDica" styleClass="v2-btn-texto" minWidth="-Infinity"/>
                </HBox>

                <VBox styleClass="v2-cartao" VBox.vgrow="ALWAYS">
<VBox styleClass="v2-cartao-topo" spacing="14.0">
                        <padding>
                            <Insets top="20.0" right="24.0" bottom="16.0" left="24.0"/>
                        </padding>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <StackPane minWidth="240.0" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                                <TextField fx:id="txtFiltroFuncionarios" promptText="Nome, código, CPF, login, cargo ou telefone" styleClass="v2-busca"/>
                                <StackPane fx:id="iconeBusca" mouseTransparent="true" maxWidth="18.0" maxHeight="18.0" StackPane.alignment="CENTER_LEFT">
                                    <StackPane.margin>
                                        <Insets left="14.0"/>
                                    </StackPane.margin>
                                </StackPane>
                                <Label fx:id="kbdBusca" text="Ctrl F" styleClass="v2-kbd, v2-oculto" managed="false" mouseTransparent="true" StackPane.alignment="CENTER_RIGHT">
                                    <StackPane.margin>
                                        <Insets right="12.0"/>
                                    </StackPane.margin>
                                </Label>
                                <Button fx:id="btnLimparBusca" onAction="#handleLimparBusca" styleClass="v2-ib" visible="false" StackPane.alignment="CENTER_RIGHT">
                                    <StackPane.margin>
                                        <Insets right="2.0"/>
                                    </StackPane.margin>
                                </Button>
                            </StackPane>
                            <Label fx:id="lblResumoLista" visible="false" managed="false"/>
                            <ComboBox fx:id="cbCargoFiltro" styleClass="v2-select" prefWidth="280.0" minWidth="-Infinity"/>
                            <Region styleClass="v2-vsep"/>
                            <Button fx:id="btnNovoFuncionario" onAction="#handleNovoFuncionario" styleClass="v2-btn, v2-btn-primary" minWidth="-Infinity"/>
                        </HBox>
                    </VBox>

<TableView fx:id="tableFuncionarios" styleClass="v2-tabela" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colCodigo" text="Código" prefWidth="108.0" minWidth="108.0"/>
                            <TableColumn fx:id="colNome" text="Nome" prefWidth="290.0"/>
                            <TableColumn fx:id="colCargo" text="Cargo" prefWidth="240.0"/>
                            <TableColumn fx:id="colTelefone" text="Telefone" prefWidth="160.0"/>
                            <TableColumn fx:id="colCpf" text="CPF" prefWidth="140.0"/>
                            <TableColumn fx:id="colAcoes" text="Ações" prefWidth="110.0" minWidth="110.0" sortable="false"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="v2-cartao-rodape">
                        <padding>
                            <Insets top="14.0" right="24.0" bottom="14.0" left="24.0"/>
                        </padding>
                        <Label fx:id="lblRodapeContagem" styleClass="v2-apoio"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Enter" styleClass="v2-kbd"/>
                        <Label text="abre o cadastro selecionado · duplo clique para editar" styleClass="v2-apoio"/>
                    </HBox>
                </VBox>
            </VBox>
        </center>
    </BorderPane>
</StackPane>
