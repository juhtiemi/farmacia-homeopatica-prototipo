<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    Cadastro de funcionário (tema v2): novo ou edição. Erros aparecem no próprio campo.
    Camada de View desacoplada da lógica; toda interação vai para o FuncionarioFormController.
-->
<StackPane fx:id="rootStack" styleClass="v2-root" prefHeight="800.0" prefWidth="1366.0" minHeight="700.0" minWidth="1100.0"
           stylesheets="@../css/tema-v2.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.farmacia.controller.FuncionarioFormController">

    <BorderPane fx:id="rootPane">
        <left>
            <fx:include fx:id="menuLateral" source="componentes/MenuLateral.fxml"/>
        </left>

        <center>
            <VBox>
                <VBox spacing="4.0">
                    <padding>
                        <Insets top="28.0" right="40.0" bottom="16.0" left="40.0"/>
                    </padding>
                    <HBox spacing="6.0" alignment="CENTER_LEFT" styleClass="v2-trilha">
                        <Label text="Início" styleClass="v2-trilha"/>
                        <Label text="/" styleClass="v2-trilha"/>
                        <Label fx:id="lnkLista" text="Funcionários" styleClass="v2-trilha-link"/>
                        <Label text="/" styleClass="v2-trilha"/>
                        <Label fx:id="lblTrilhaAtual" text="Novo funcionário" styleClass="v2-trilha"/>
                    </HBox>
                    <Label fx:id="lblTituloPagina" text="Novo funcionário" styleClass="v2-titulo"/>
                    <Label fx:id="lblSubtituloPagina" styleClass="v2-subtitulo"/>
                </VBox>

                <ScrollPane fitToWidth="true" styleClass="v2-scroll" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox spacing="20.0">
                            <padding>
                                <Insets top="4.0" right="40.0" bottom="24.0" left="40.0"/>
                            </padding>
                            <HBox spacing="6.0" alignment="CENTER_LEFT">
                                <Label text="*" styleClass="v2-obrigatorio"/>
                                <Label text="Campos obrigatórios" styleClass="v2-secao-dica"/>
                            </HBox>

                            <VBox styleClass="v2-form-cartao" spacing="16.0">
                                <Label text="Dados pessoais" styleClass="v2-secao-titulo"/>
                                <GridPane hgap="16.0" vgap="16.0">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="25.0"/>
                                        <ColumnConstraints percentWidth="25.0"/>
                                        <ColumnConstraints percentWidth="25.0"/>
                                        <ColumnConstraints percentWidth="25.0"/>
                                    </columnConstraints>
                                    <VBox styleClass="v2-campo" spacing="6.0" GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.columnSpan="1">
                                        <HBox spacing="4.0" alignment="CENTER_LEFT">
                                            <Label text="Código" styleClass="v2-label"/>
                                        </HBox>
                                        <TextField fx:id="txtCodigo" promptText="Automático" styleClass="v2-input, v2-input-leitura" editable="false"/>
                                    </VBox>
                                    <VBox styleClass="v2-campo" spacing="6.0" GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.columnSpan="3">
                                        <HBox spacing="4.0" alignment="CENTER_LEFT">
                                            <Label text="Nome" styleClass="v2-label"/>
                                            <Label text="*" styleClass="v2-obrigatorio"/>
                                        </HBox>
                                        <TextField fx:id="txtNome" promptText="Nome completo" styleClass="v2-input"/>
                                    </VBox>
                                    <VBox styleClass="v2-campo" spacing="6.0" GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.columnSpan="2">
                                        <HBox spacing="4.0" alignment="CENTER_LEFT">
                                            <Label text="CPF" styleClass="v2-label"/>
                                        </HBox>
                                        <TextField fx:id="txtCpf" promptText="000.000.000-00" styleClass="v2-input"/>
                                    </VBox>
                                    <VBox styleClass="v2-campo" spacing="6.0" GridPane.rowIndex="1" GridPane.columnIndex="2" GridPane.columnSpan="2">
                                        <HBox spacing="4.0" alignment="CENTER_LEFT">
                                            <Label text="Telefone" styleClass="v2-label"/>
                                        </HBox>
                                        <TextField fx:id="txtTelefone" promptText="(00) 00000-0000" styleClass="v2-input"/>
                                    </VBox>
                                </GridPane>
                            </VBox>

                            <VBox styleClass="v2-form-cartao" spacing="16.0">
                                <Label text="Acesso e função" styleClass="v2-secao-titulo"/>
                                <Label text="O login identifica o funcionário no sistema e não pode se repetir. Use letras e números sem espaços, como maria.silva."
                                       styleClass="v2-secao-dica" wrapText="true"/>
                                <GridPane hgap="16.0" vgap="16.0">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="25.0"/>
                                        <ColumnConstraints percentWidth="25.0"/>
                                        <ColumnConstraints percentWidth="25.0"/>
                                        <ColumnConstraints percentWidth="25.0"/>
                                    </columnConstraints>
                                    <VBox styleClass="v2-campo" spacing="6.0" GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.columnSpan="2">
                                        <HBox spacing="4.0" alignment="CENTER_LEFT">
                                            <Label text="Login / Usuário" styleClass="v2-label"/>
                                            <Label text="*" styleClass="v2-obrigatorio"/>
                                        </HBox>
                                        <TextField fx:id="txtLogin" promptText="Ex.: maria.silva" styleClass="v2-input"/>
                                    </VBox>
                                    <VBox styleClass="v2-campo" spacing="6.0" GridPane.rowIndex="0" GridPane.columnIndex="2" GridPane.columnSpan="2">
                                        <HBox spacing="4.0" alignment="CENTER_LEFT">
                                            <Label text="Cargo / Função" styleClass="v2-label"/>
                                        </HBox>
                                        <ComboBox fx:id="cbCargo" editable="true" maxWidth="Infinity" promptText="Selecione ou digite" styleClass="v2-input">
                                            <items>
                                                <FXCollections fx:factory="observableArrayList">
                                                    <String fx:value="Farmacêutico(a) Responsável"/>
                                                    <String fx:value="Farmacêutico(a)"/>
                                                    <String fx:value="Auxiliar de Manipulação"/>
                                                    <String fx:value="Atendente de Balcão"/>
                                                    <String fx:value="Caixa"/>
                                                    <String fx:value="Gerente"/>
                                                    <String fx:value="Entregador(a)"/>
                                                    <String fx:value="Outro"/>
                                                </FXCollections>
                                            </items>
                                        </ComboBox>
                                    </VBox>
                                </GridPane>
                            </VBox>
                        </VBox>
                    </content>
                </ScrollPane>

                <HBox styleClass="v2-barra-acoes">
                    <Button fx:id="btnCancelar" onAction="#handleCancelar" styleClass="v2-btn, v2-btn-ghost"/>
                    <Button fx:id="btnSalvarFuncionario" onAction="#handleSalvarFuncionario" styleClass="v2-btn, v2-btn-primary"/>
                </HBox>
            </VBox>
        </center>
    </BorderPane>
</StackPane>
