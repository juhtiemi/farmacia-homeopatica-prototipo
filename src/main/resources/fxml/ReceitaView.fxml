<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    Lista de Receitas (tema v2): busca, filtros por status, período e médico, ações por linha e avisos em toast.
    A raiz é um StackPane para que avisos e caixas de confirmação flutuem sobre a tela.
    Camada de View (FXML) desacoplada da lógica; toda interação vai para o ReceitaController.
-->
<StackPane fx:id="rootStack" styleClass="v2-root" prefHeight="800.0" prefWidth="1366.0" minHeight="700.0" minWidth="1100.0"
           stylesheets="@../css/tema-v2.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.farmacia.controller.ReceitaController">

    <BorderPane fx:id="rootPane">
        <left>
            <fx:include fx:id="menuLateral" source="componentes/MenuLateral.fxml"/>
        </left>

        <center>
            <VBox fx:id="receitaContent" spacing="20.0">
                <padding>
                    <Insets top="28.0" right="40.0" bottom="32.0" left="40.0"/>
                </padding>

                <!-- Cabeçalho: trilha, título e ajuda -->
                <HBox alignment="BOTTOM_LEFT" spacing="16.0">
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <HBox spacing="6.0" alignment="CENTER_LEFT" styleClass="v2-trilha">
                            <Label fx:id="lnkInicio" text="Início" styleClass="v2-trilha"/>
                            <Label text="/" styleClass="v2-trilha"/>
                            <Label text="Receitas" styleClass="v2-trilha"/>
                        </HBox>
                        <Label text="Receitas" styleClass="v2-titulo"/>
                        <Label text="Consulte, crie ou duplique pedidos de manipulação." styleClass="v2-subtitulo"/>
                    </VBox>
                    <Button fx:id="btnAjuda" onAction="#handleAjuda" styleClass="v2-btn, v2-btn-ghost"/>
                </HBox>

                <!-- Dica dispensável (aparece até o usuário dizer que entendeu) -->
                <HBox fx:id="dicaBox" alignment="CENTER_LEFT" spacing="12.0" styleClass="v2-dica">
                    <StackPane fx:id="dicaIcone"/>
                    <Label fx:id="lblDica" wrapText="true" HBox.hgrow="ALWAYS"
                           text="Para duplicar um pedido, use o ícone de duplicar na linha da receita. A cópia abre como rascunho e só é salva quando você confirmar."/>
                    <Button text="Entendi" onAction="#handleDispensarDica" styleClass="v2-btn-texto"/>
                </HBox>

                <!-- Cartão da lista -->
                <VBox styleClass="v2-cartao" VBox.vgrow="ALWAYS">
<VBox styleClass="v2-cartao-topo" spacing="14.0">
                        <padding>
                            <Insets top="20.0" right="24.0" bottom="0.0" left="24.0"/>
                        </padding>
                        <fx:define>
                                <ToggleGroup fx:id="grupoStatus"/>
                            </fx:define>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <StackPane minWidth="240.0" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                                <TextField fx:id="txtFiltroReceitas" promptText="Paciente, responsável, médico, código ou medicamento" styleClass="v2-busca"/>
                                <StackPane fx:id="iconeBusca" mouseTransparent="true" maxWidth="18.0" maxHeight="18.0" StackPane.alignment="CENTER_LEFT">
                                    <StackPane.margin>
                                        <Insets left="14.0"/>
                                    </StackPane.margin>
                                </StackPane>
                                <Label fx:id="kbdBusca" text="Ctrl F" styleClass="v2-kbd, v2-oculto" managed="false" mouseTransparent="true" StackPane.alignment="CENTER_RIGHT">
                                    <StackPane.margin>
                                        <Insets right="12.0"/>
                                    </StackPane.margin>
                                </Label>
                                <Button fx:id="btnLimparBusca" onAction="#handleLimparBusca" styleClass="v2-ib" visible="false" StackPane.alignment="CENTER_RIGHT">
                                    <StackPane.margin>
                                        <Insets right="2.0"/>
                                    </StackPane.margin>
                                </Button>
                            </StackPane>
                            <Label fx:id="lblResumoLista" visible="false" managed="false"/>
                            <ComboBox fx:id="cbPeriodo" styleClass="v2-select" prefWidth="190.0" minWidth="-Infinity"/>
                            <ComboBox fx:id="cbMedico" styleClass="v2-select" prefWidth="220.0" minWidth="-Infinity"/>
                            <Region styleClass="v2-vsep"/>
                            <Button fx:id="btnNovaReceita" onAction="#handleNovaReceita" styleClass="v2-btn, v2-btn-primary" minWidth="-Infinity"/>
                        </HBox>
                        <HBox styleClass="v2-abas" alignment="BOTTOM_LEFT">
                            <ToggleButton fx:id="tgTodas" text="Todas" selected="true" toggleGroup="$grupoStatus" styleClass="v2-aba" minWidth="-Infinity"/>
                            <ToggleButton fx:id="tgManipulacao" text="Em manipulação" toggleGroup="$grupoStatus" styleClass="v2-aba" minWidth="-Infinity"/>
                            <ToggleButton fx:id="tgProntas" text="Prontas" toggleGroup="$grupoStatus" styleClass="v2-aba" minWidth="-Infinity"/>
                            <ToggleButton fx:id="tgEntregues" text="Entregues" toggleGroup="$grupoStatus" styleClass="v2-aba" minWidth="-Infinity"/>
                            <ToggleButton fx:id="tgCanceladas" text="Canceladas" toggleGroup="$grupoStatus" styleClass="v2-aba" minWidth="-Infinity"/>
                        </HBox>
                    </VBox>

<TableView fx:id="tableReceitas" styleClass="v2-tabela" VBox.vgrow="ALWAYS" fixedCellSize="0.0">
                        <!-- Paciente fica mais larga (o responsável aparece inteiro) e Status cabe o selo com a seta ▾;
                             a largura sai de Código e Médico, que tinham folga. -->
                        <columns>
                            <TableColumn fx:id="colCodigo" text="Código" prefWidth="112.0" minWidth="100.0"/>
                            <TableColumn fx:id="colData" text="Data da prescrição" prefWidth="148.0" minWidth="138.0"/>
                            <TableColumn fx:id="colPaciente" text="Paciente" prefWidth="258.0"/>
                            <TableColumn fx:id="colMedico" text="Médico" prefWidth="221.0"/>
                            <TableColumn fx:id="colMedicamentos" text="Medicamentos" prefWidth="231.0" sortable="false"/>
                            <TableColumn fx:id="colStatus" text="Status" prefWidth="200.0" minWidth="192.0"/>
                            <TableColumn fx:id="colAcoes" text="Ações" prefWidth="140.0" minWidth="140.0" sortable="false"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="v2-cartao-rodape">
                        <padding>
                            <Insets top="14.0" right="24.0" bottom="14.0" left="24.0"/>
                        </padding>
                        <Label fx:id="lblRodapeContagem" styleClass="v2-apoio"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Enter" styleClass="v2-kbd"/>
                        <Label text="abre a receita selecionada · duplo clique para editar" styleClass="v2-apoio"/>
                    </HBox>
                </VBox>
            </VBox>
        </center>
    </BorderPane>
</StackPane>
